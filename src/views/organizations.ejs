 <%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here are a few of our partner organizations:</p>

    <ul>
        <% organizations.forEach(organization => { %>
            <li>
                <img
                    src="/images/<%= organization.logo_filename || 'placeholder-logo.png' %>"
                    alt="<%= organization.name %> logo"
                    width="100"
                >

                <strong>
                    <a href="/organization/<%= organization.organization_id %>">
                        <%= organization.name %>
                    </a>
                </strong>:
                <%= organization.contact_email %>
            </li>
        <% }); %>
    </ul>

    <p>
        <a href="/new-organization">Add a new organization</a>
    </p>
</main>

<%- include('partials/footer') %>