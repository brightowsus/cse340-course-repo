 <%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <form action="/new-organization" method="POST">
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
      ></textarea>
    </div>

    <div class="form-group">
      <label for="contact_email">Contact Email</label>
      <input
        type="email"
        id="contact_email"
        name="contact_email"
        required
      />
    </div>
    <div class="form-group">
  <label for="logo_filename">Logo Filename</label>
  <input
    type="text"
    id="logo_filename"
    name="logo_filename"
    value="default-logo.png"
    required
  />
</div>

    <button type="submit">Create Organization</button>
  </form>
</main>

<%- include('partials/footer') %>